#!/bin/bash
# steamos-nested-desktop: the Steam Frame's desktop mode (a nested KDE Plasma) on the Quest 1.
# The Frame's own script (/usr/bin/steamos-nested-desktop, run by Steam for its "Desktop" entry, "+" menu)
# with one difference, marked "Quest 1": on the Frame this runs inside gamescope, whose OpenVR backend shows
# the app's window as a SteamVR overlay. gamescope can't run on the Adreno 540's Vulkan 1.1 blob (no DRM
# format modifiers, no dma-buf import), so kwin draws into an Xvfb of its own size and q1desktop shows that
# Xvfb as the overlay gamescope would create, with the laser, scroll and SteamVR keyboard as input
# (docs/desktop.md).

set -eu

# Quest 1: "Desktop" launched from inside the desktop (Plasma's menu lists it too): the desktop is already
# shown. Going on would start a second one inside it (its own Xvfb, kwin, Plasma, an overlay SteamVR refuses).
case "${XDG_RUNTIME_DIR:-}" in */nested_plasma) exit 0 ;; esac

# Quest 1: the desktop and everything run from it (Xvfb, q1desktop, Plasma, its apps) yield the CPUs to the VR stack:
# with Discover installing a flatpak and the system monitor open, the load went to ~18 and vrcompositor down to
# 50-55 fps for half a minute, every missing frame an image jump (user, 2026-11-09). Its frames and input may lag
# instead.
renice -n 10 -p $$ >/dev/null 2>&1 || true

# Remove the performance overlay, it meddles with some tasks
unset LD_PRELOAD

# Undo gamescope's session startup script that sets XDG_DESKTOP_PORTAL_DIR
# to ensure xdg-desktop-portal doesn't try to start desktop portals
unset XDG_DESKTOP_PORTAL_DIR

# Quest 1: Steam runs on the Adreno's Vulkan (steam-q1: our Vulkan shim first in LD_LIBRARY_PATH, Steam's
# runtime after it) and passes that on. The desktop is the system's: Qt probes Vulkan, and the shim without
# libhybris' TLS preload crashes it (ksplash, kded6, the portals, plasmashell never up: a black desktop).
unset LD_LIBRARY_PATH QUEST1_VK_REDIRECT QUEST1_VKSHIM_WSI QUEST1_STEAMVR_COMPAT QUEST1_STEAM_VR MESA_EXTENSION_OVERRIDE

W=1280 H=800
pids=()

# Quest 1: the processes of the nested session, found by their XDG_RUNTIME_DIR. Some leave Plasma's process
# group for sessions of their own (kcminit, stuck once kwin is gone) and outlived the desktop, holding memory
# and, before children stopped inheriting it, the lock below: every later launch then saw a desktop running
# and showed nothing. Builtins only, so the scan finds none of its own commands.
function nested_pids()
{
    local p v
    npids=()
    for p in /proc/[0-9]*; do
        [ "${p#/proc/}" = "$$" ] && continue
        while IFS= read -r -d '' v; do
            [ "$v" = "XDG_RUNTIME_DIR=$NEW_XDG_RUNTIME_DIR" ] && { npids+=("${p#/proc/}"); break; }
        done 2>/dev/null < "$p/environ"
    done
}

function end_nested()
{
    local i
    for i in $(seq 15); do
        nested_pids
        [ ${#npids[@]} -eq 0 ] && return
        if [ $i -eq 1 ]; then kill -TERM "${npids[@]}" 2>/dev/null; fi
        if [ $i -eq 15 ]; then kill -KILL "${npids[@]}" 2>/dev/null; fi
        sleep 0.2
    done
}

function cleanup()
{
    # Quest 1: our Xvfb and overlay
    [ -n "${plasma:-}" ] && kill -TERM -- -$plasma 2>/dev/null || true
    for p in "${pids[@]}"; do kill "$p" 2>/dev/null || true; done
    end_nested || true
    # Flush fuse mounts beneath here
    umount --recursive $NEW_XDG_RUNTIME_DIR 2>/dev/null || true
    # Quest 1: as a user, umount can't take the document portal's FUSE mount (doc/), whose portal may still be
    # exiting: unmount it lazily. A failed rm used to end the next launch at once (set -e), nothing shown.
    awk -v d="$NEW_XDG_RUNTIME_DIR/" 'index($2, d) == 1 {print $2}' /proc/mounts | while read -r m; do
        fusermount3 -u -z "$m" 2>/dev/null || true
    done
    rm -Rf $NEW_XDG_RUNTIME_DIR || true
}

# Quest 1: one desktop at a time. Plasma takes a while to come up here, and a second launch (a second click
# on "Desktop") would clean up the running one's XDG_RUNTIME_DIR: it shows the running one instead. The lock is
# this script's alone (9>&- below): a child left behind must not keep it.
exec 9>"$XDG_RUNTIME_DIR/nested_plasma.lock"
if ! flock -n 9; then
    pkill -USR1 -x q1desktop && exit 0
    # No overlay: either the running launch hasn't started q1desktop yet (it shows itself), or the last desktop
    # was just closed and is still ending. In that case this click must open a new one, not be lost.
    flock -w 20 9 || exit 0
fi
# Steam starts apps with the C locale here: the system's
[ -r /etc/locale.conf ] && . /etc/locale.conf && export LANG

# Create a new XDG_RUNTIME_DIR
NEW_XDG_RUNTIME_DIR=$XDG_RUNTIME_DIR/nested_plasma
trap cleanup EXIT

cleanup
mkdir -p $NEW_XDG_RUNTIME_DIR --mode 0700

# Some things are (currently) shared, pulseaudio socket needs to be connected to the main session
mkdir -p $NEW_XDG_RUNTIME_DIR/pulse --mode 0700
ln -sfn $XDG_RUNTIME_DIR/pulse/native $NEW_XDG_RUNTIME_DIR/pulse/native
ln -sf $XDG_RUNTIME_DIR/pipewire* $NEW_XDG_RUNTIME_DIR/.

# Quest 1: gamescope's part. An X server for kwin's window (the first free display from :2), its
# framebuffer exported for q1desktop, which runs on the Adreno like SteamVR's own clients.
n=2
while [ -e /tmp/.X11-unix/X$n ] || [ -e /tmp/.X$n-lock ]; do n=$((n + 1)); done
mkdir -p $NEW_XDG_RUNTIME_DIR/xvfb
Xvfb :$n -screen 0 ${W}x${H}x24 -fbdir $NEW_XDG_RUNTIME_DIR/xvfb -nolisten tcp -noreset 9>&- &
pids+=($!)
for i in $(seq 50); do [ -e /tmp/.X11-unix/X$n ] && break; sleep 0.1; done
export DISPLAY=:$n
# Quest 1: a second launch signals q1desktop (above). A SIGUSR1 before q1desktop has its handler (after
# SteamVR's init, seconds) ended it, and the desktop with it: every launch died this way and only a lucky
# click got through. It starts with the signal ignored, its handler replaces that.
trap '' USR1
LD_PRELOAD=/opt/hybris/lib/libbionictls.so \
LD_LIBRARY_PATH=/usr/local/lib/quest1-vk-steam:/opt/hybris/lib \
QUEST1_STEAMVR_COMPAT=1 \
Q1D_ICON=${Q1D_ICON:-/usr/share/applications/steam/steamos-nested-desktop/icon.png} \
    /usr/local/bin/q1desktop $NEW_XDG_RUNTIME_DIR/xvfb/Xvfb_screen0 9>&- &
q1d=$!
pids+=($q1d)
trap - USR1

## Shadow kwin_wayland_wrapper so that we can pass args to kwin wrapper
## whilst being launched by plasma-session
mkdir -p $NEW_XDG_RUNTIME_DIR/bin
# Quest 1: no_new_privs: kwin_wayland's file capability (cap_sys_nice) would make its main thread real-time, above
# every normal thread of the VR stack
cat <<EOF > $NEW_XDG_RUNTIME_DIR/bin/kwin_wayland_wrapper
#!/bin/sh
exec setpriv --no-new-privs /usr/bin/kwin_wayland_wrapper --width $W --height $H --no-lockscreen \$@
EOF
chmod a+x $NEW_XDG_RUNTIME_DIR/bin/kwin_wayland_wrapper
export PATH=$NEW_XDG_RUNTIME_DIR/bin:$PATH

export XDG_RUNTIME_DIR=$NEW_XDG_RUNTIME_DIR

# Quest 1: in its own process group, ended when the overlay is closed from its control bar (on the Frame,
# closing the app's window ends it)
setsid dbus-run-session startplasma-wayland 9>&- &
plasma=$!
while kill -0 $plasma 2>/dev/null; do
    kill -0 $q1d 2>/dev/null || { kill -TERM -- -$plasma 2>/dev/null || true; break; }
    sleep 1
done
wait $plasma || true
