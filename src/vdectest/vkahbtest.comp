#version 450
// vkahbtest: the YCbCr gralloc buffer, sampled through its sampler conversion, to RGBA8 words in a buffer
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0) uniform sampler2D src;
layout(set = 0, binding = 1, std430) writeonly buffer Out { uint d[]; };
layout(push_constant) uniform P { uint w; uint h; } p;
void main()
{
	uvec2 c = gl_GlobalInvocationID.xy;
	if (c.x >= p.w || c.y >= p.h)
		return;
	vec4 v = textureLod(src, (vec2(c) + 0.5) / vec2(p.w, p.h), 0.0);
	uvec4 b = uvec4(clamp(v, 0.0, 1.0) * 255.0 + 0.5);
	d[c.y * p.w + c.x] = b.r | (b.g << 8) | (b.b << 16) | (b.a << 24);
}
