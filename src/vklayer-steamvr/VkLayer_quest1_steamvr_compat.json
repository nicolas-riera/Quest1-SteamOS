{
	"file_format_version": "1.2.0",
	"layer": {
		"name": "VK_LAYER_QUEST1_steamvr_compat",
		"type": "GLOBAL",
		"library_path": "/usr/local/lib/libVkLayer_quest1_steamvr_compat.so",
		"api_version": "1.1.128",
		"implementation_version": "1",
		"description": "SteamVR on the Adreno 540 blob: timeline semaphore emulation, required-by-name extensions",
		"enable_environment": {
			"QUEST1_STEAMVR_COMPAT": "1"
		},
		"disable_environment": {
			"QUEST1_STEAMVR_COMPAT_DISABLE": "1"
		},
		"device_extensions": [
			{
				"name": "VK_KHR_timeline_semaphore",
				"spec_version": "2",
				"entrypoints": [
					"vkGetSemaphoreCounterValueKHR",
					"vkWaitSemaphoresKHR",
					"vkSignalSemaphoreKHR"
				]
			},
			{
				"name": "VK_EXT_shader_viewport_index_layer",
				"spec_version": "1"
			},
			{
				"name": "VK_EXT_extended_dynamic_state3",
				"spec_version": "2"
			}
		]
	}
}
