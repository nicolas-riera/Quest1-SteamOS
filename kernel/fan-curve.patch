+/*
+ * Quest1-SteamOS: the fan follows the temperature. This driver had two speeds with the screen on: cooling level 1
+ * (120 of 255) and, once a zone reached its trip (85.0 C for the tsens zones), level 2 (full), so the fan stayed
+ * slow up to 85 C and then jumped to full; with the screen off it stopped, however hot (the panels go off when the
+ * headset is taken off, with SteamVR and the tracking still at work); and this poll sets the speed every second, so
+ * nothing else can. Now the speed rises from level 1 to full over FAN_CURVE_SPAN below each zone's trip, led by the
+ * zone closest to its trip, and comes down by FAN_CURVE_STEP per second at most, never below level 1, screen on or
+ * off. A tripped zone keeps full speed until it is back below its trip by its hysteresis.
+ */
+#define FAN_CURVE_STEP 8
+
+static int fan_curve_span(unsigned int trip)
+{
+	/* the tsens zones are in 0.1 C (trip 850: from 60 C), the battery in mC (trip 48000: from 40 C) */
+	return trip < 2000 ? 250 : 8000;
+}
