# Additions on top of the stock Quest 1 config (recon/kernel.config) for a
# SteamOS/Holo userland (systemd, podman/Lepton, FEX). Nothing is removed.
# --- IPC / namespaces (systemd, podman, Lepton) ---
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_USER_NS=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CHECKPOINT_RESTORE=y
CONFIG_BPF_SYSCALL=y
# --- systemd requirements ---
CONFIG_FHANDLE=y
CONFIG_DEVTMPFS=y
# CONFIG_DEVTMPFS_MOUNT is not set
CONFIG_AUTOFS4_FS=y
# --- filesystems ---
CONFIG_OVERLAY_FS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_LZ4=y
CONFIG_BTRFS_FS=y
CONFIG_BTRFS_FS_POSIX_ACL=y
# --- FEX (x86 emulation via binfmt) ---
CONFIG_BINFMT_MISC=y
# --- container networking ---
CONFIG_VETH=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
# --- debug: USB serial (network via NCM, already in stock), extra USB devices ---
CONFIG_USB_CONFIGFS_SERIAL=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_ACM=y
CONFIG_USB_HIDDEV=y
CONFIG_SND_USB_AUDIO=y

# hardware RNG (feeds the entropy pool; systemd-random-seed otherwise blocks ~40 s)
CONFIG_HW_RANDOM_MSM_LEGACY=y
