# Additions on top of the stock Quest 1 config (recon/kernel.config) for a
# SteamOS/Holo userland (systemd, podman/Lepton, FEX). Nothing is removed.
# --- IPC / namespaces (systemd, podman, Lepton) ---
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_PID_NS=y
CONFIG_USER_NS=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_DEVICE=y
CONFIG_CHECKPOINT_RESTORE=y
CONFIG_BPF_SYSCALL=y
# --- systemd requirements ---
CONFIG_FHANDLE=y
CONFIG_DEVTMPFS=y
# CONFIG_DEVTMPFS_MOUNT is not set
CONFIG_AUTOFS4_FS=y
# --- filesystems ---
CONFIG_OVERLAY_FS=y
CONFIG_SQUASHFS=y
CONFIG_SQUASHFS_XZ=y
CONFIG_SQUASHFS_LZ4=y
CONFIG_BTRFS_FS=y
CONFIG_BTRFS_FS_POSIX_ACL=y
# --- FEX (x86 emulation via binfmt) ---
CONFIG_BINFMT_MISC=y
# --- container networking ---
CONFIG_VETH=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
# --- debug: USB serial (network via NCM, already in stock), extra USB devices ---
CONFIG_USB_CONFIGFS_SERIAL=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_USB_ACM=y
CONFIG_USB_HIDDEV=y
CONFIG_SND_USB_AUDIO=y

# hardware RNG (feeds the entropy pool; systemd-random-seed otherwise blocks ~40 s)
CONFIG_HW_RANDOM_MSM_LEGACY=y

# the installer's micro Linux: its scratch disk is a file on the PC, served over USB as a network block device
CONFIG_BLK_DEV_NBD=y

# Bluetooth: the WCN3990 on its UART (hci_uart QCA, kernel/bt-wcn3990.patch), BlueZ's profiles
CONFIG_BT_HCIUART=y
CONFIG_BT_HCIUART_H4=y
CONFIG_BT_HCIUART_QCA=y
CONFIG_BT_RFCOMM=y
CONFIG_BT_RFCOMM_TTY=y
CONFIG_BT_BNEP=y
CONFIG_BT_BNEP_MC_FILTER=y
CONFIG_BT_BNEP_PROTO_FILTER=y
CONFIG_BT_HIDP=y
# Bluetooth input devices: Sony and Microsoft pads (Steam itself reads pads through hidraw), Apple keyboards
CONFIG_HID_SONY=y
CONFIG_SONY_FF=y
CONFIG_HID_MICROSOFT=y
CONFIG_HID_APPLE=y

# devpts instances of their own (mount -o newinstance): bubblewrap's sandboxes mount one, and without it they all
# fail ("Can't mount devpts on /newroot/dev/pts"): Steam's icon loaders (glycin), flatpak, pressure-vessel.
# Mounts without newinstance (systemd's /dev/pts, the initramfs) still share the first instance, as before.
CONFIG_DEVPTS_MULTIPLE_INSTANCES=y
