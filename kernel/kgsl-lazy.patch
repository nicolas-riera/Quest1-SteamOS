+/* A lazy memdesc's page got its own memory: the GPU sees it from now on */
+int kgsl_iommu_lazy_remap(struct kgsl_pagetable *pt,
+		struct kgsl_memdesc *memdesc, uint64_t offset, struct page *page)
+{
+	uint64_t addr = memdesc->gpuaddr + offset;
+	int ret;
+
+	ret = _iommu_unmap_sync_pc(pt, memdesc, addr, PAGE_SIZE);
+	if (ret)
+		return ret;
+
+	return _iommu_map_sync_pc(pt, memdesc, addr, page_to_phys(page),
+			PAGE_SIZE, _get_protection_flags(memdesc));
+}
