 	if (memdesc->pages != NULL)
 		kgsl_pool_free_pages(memdesc->pages, memdesc->page_count);
@@ -746,6 +851,23 @@ int kgsl_cache_range_op(struct kgsl_memdesc *memdesc, uint64_t offset,
 	if (offset + size > memdesc->size)
 		return -ERANGE;
 
+	/* Lazy memdescs: page by page, skipping the scratch page */
+	if (memdesc->priv & KGSL_MEMDESC_LAZY) {
+		uint64_t end = offset + size;
+
+		while (offset < end) {
+			unsigned int in = offset & ~PAGE_MASK;
+			uint64_t len = min_t(uint64_t, end - offset,
+					PAGE_SIZE - in);
+			struct page *page = memdesc->pages[offset >> PAGE_SHIFT];
+
+			if (page != kgsl_lazy_scratch)
+				ret = kgsl_do_cache_op(page, NULL, in, len, op);
+			offset += len;
+		}
+		return ret;
+	}
+
