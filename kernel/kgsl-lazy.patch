 		/* Make sure the offset + size do not overflow the address */
diff --git a/include/uapi/linux/msm_kgsl.h b/include/uapi/linux/msm_kgsl.h
index 4a88598f..5bd0c84c 100644
--- a/include/uapi/linux/msm_kgsl.h
