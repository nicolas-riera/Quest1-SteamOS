+/*
+ * Lazy memdescs (IOCTL_KGSL_LAZY_NEXT): every page starts as this shared
+ * scratch page, in the pages array and in the GPU pagetable, and gets its own
+ * zeroed page at the first CPU fault on it.
+ */
+static struct page *kgsl_lazy_scratch;
+static DEFINE_MUTEX(kgsl_lazy_mutex);
+static struct kgsl_memdesc_ops kgsl_page_alloc_ops;
+
+static int kgsl_sharedmem_page_alloc_lazy(struct kgsl_memdesc *memdesc,
+		uint64_t size)
+{
+	unsigned int i, count;
+
+	size = PAGE_ALIGN(size);
+	if (size == 0 || size > UINT_MAX)
+		return -EINVAL;
+
+	mutex_lock(&kgsl_lazy_mutex);
+	if (kgsl_lazy_scratch == NULL)
+		kgsl_lazy_scratch = alloc_page(GFP_KERNEL | __GFP_ZERO);
+	mutex_unlock(&kgsl_lazy_mutex);
+	if (kgsl_lazy_scratch == NULL)
+		return -ENOMEM;
+
+	count = size >> PAGE_SHIFT;
+	memdesc->pages = kgsl_malloc(count * sizeof(struct page *));
+	if (memdesc->pages == NULL)
+		return -ENOMEM;
+	for (i = 0; i < count; i++)
+		memdesc->pages[i] = kgsl_lazy_scratch;
+
+	/* 4 KiB GPU pages, so that each one can be pointed elsewhere */
+	kgsl_memdesc_set_align(memdesc, PAGE_SHIFT);
+	memdesc->ops = &kgsl_page_alloc_ops;
+	memdesc->page_count = count;
+	memdesc->size = size;
+	return 0;
+}
+
+static struct page *kgsl_lazy_populate(struct kgsl_memdesc *memdesc,
+		unsigned int pgoff)
+{
+	struct page *page;
+	void *addr;
+	int ret;
+
+	mutex_lock(&kgsl_lazy_mutex);
+	page = memdesc->pages[pgoff];
+	if (page != kgsl_lazy_scratch)
+		goto out;
+
+	page = alloc_page(GFP_KERNEL | __GFP_ZERO);
+	if (page == NULL) {
+		page = ERR_PTR(-ENOMEM);
+		goto out;
+	}
+	/* zeroed through the CPU cache: clean it for the GPU */
+	addr = kmap_atomic(page);
+	dmac_flush_range(addr, addr + PAGE_SIZE);
+	kunmap_atomic(addr);
+
+	if ((memdesc->priv & KGSL_MEMDESC_MAPPED) && memdesc->pagetable) {
+		ret = kgsl_iommu_lazy_remap(memdesc->pagetable, memdesc,
+				(uint64_t) pgoff << PAGE_SHIFT, page);
+		if (ret) {
+			__free_page(page);
+			page = ERR_PTR(ret);
+			goto out;
+		}
+	}
+	memdesc->pages[pgoff] = page;
+	KGSL_STATS_ADD(PAGE_SIZE, &kgsl_driver.stats.page_alloc,
+		&kgsl_driver.stats.page_alloc_max);
+out:
+	mutex_unlock(&kgsl_lazy_mutex);
+	return page;
+}
