+/**
+ * struct kgsl_lazy_next - back an allocation on first CPU touch (Quest 1)
+ * @size: size of the next allocation of the calling process to treat so
+ *
+ * The next KGSL allocation of exactly @size bytes by the calling process gets
+ * no memory up front: every GPU page points at a scratch page, and each page
+ * gets its own memory the first time the CPU touches it, then the GPU sees
+ * that page in place. For upload rings: the CPU writes before the GPU reads.
+ * What the GPU writes to a page the CPU never touched is lost.
+ */
+struct kgsl_lazy_next {
+	uint64_t size;
+};
+
+#define IOCTL_KGSL_LAZY_NEXT \
+	_IOW(KGSL_IOC_TYPE, 0x58, struct kgsl_lazy_next)
+
 #define IOCTL_KGSL_ALLOW_TID_MAXIMUM_PRIORITY \
 	_IOW(KGSL_IOC_TYPE, 0x57, struct kgsl_allow_tid_maximum_priority)
 
