 static void ft(const char *what, int64_t arg); // quest1_display.c (frame trace)
 
+// TEMP lock-in: which float of vrcompositor's mapped memory oscillates at a known frequency (the shim's pose sine).
+// /tmp/q1-maplist: the mapped allocations to /tmp/q1maps.txt; /tmp/q1-lockin "HZ MAXBYTES": every float of the
+// mapped allocations up to MAXBYTES, sampled at each vkQueueSubmit (at most every 4 ms), to /tmp/q1lockin.txt when
+// the file goes away.
+#define LI_ALLOCS 8192
+static struct
+{
+	uint64_t mem, size;
+	uint32_t type;
+	uint8_t *ptr;
+	uint64_t mapsize;
+	double *acc; // per float: sum, sum sin, sum cos, sum sq
+	uint64_t nf;
+} li_a[LI_ALLOCS];
+static pthread_mutex_t li_lock = PTHREAD_MUTEX_INITIALIZER;
+static double li_hz;
+static uint64_t li_max, li_n, li_t0, li_last, li_chk;
+static bool li_on;
+
+static int li_find(uint64_t mem, bool add)
+{
+	int fr = -1;
+	for (int i = 0; i < LI_ALLOCS; i++) {
+		if (li_a[i].mem == mem)
+			return i;
+		if (!li_a[i].mem && fr < 0)
+			fr = i;
+	}
+	return add ? fr : -1;
+}
+
+static void li_alloc(VkDeviceMemory m, const VkMemoryAllocateInfo *ai)
+{
+	pthread_mutex_lock(&li_lock);
+	int i = li_find((uint64_t)m, true);
+	if (i >= 0) {
+		free(li_a[i].acc);
+		memset(&li_a[i], 0, sizeof(li_a[i]));
+		li_a[i].mem = (uint64_t)m;
+		li_a[i].size = ai->allocationSize;
+		li_a[i].type = ai->memoryTypeIndex;
+		const VkImportMemoryHostPointerInfoEXT *hp =
+		    find_struct(ai->pNext, VK_STRUCTURE_TYPE_IMPORT_MEMORY_HOST_POINTER_INFO_EXT);
+		if (hp) { // host memory the CPU writes as it is
+			li_a[i].ptr = hp->pHostPointer;
+			li_a[i].mapsize = ai->allocationSize;
+			li_a[i].type |= 0x80000000u;
+		}
+	}
+	pthread_mutex_unlock(&li_lock);
+}
+
+static void li_map(VkDeviceMemory m, void *ptr, VkDeviceSize off, VkDeviceSize size)
+{
+	pthread_mutex_lock(&li_lock);
+	int i = li_find((uint64_t)m, false);
+	if (i >= 0) {
+		li_a[i].ptr = ptr;
+		li_a[i].mapsize = !ptr ? 0 : size == VK_WHOLE_SIZE ? li_a[i].size - off : size;
+		free(li_a[i].acc);
+		li_a[i].acc = NULL;
+		li_a[i].nf = 0;
+	}
+	pthread_mutex_unlock(&li_lock);
+}
+
+static void li_free(VkDeviceMemory m)
+{
+	pthread_mutex_lock(&li_lock);
+	int i = li_find((uint64_t)m, false);
+	if (i >= 0) {
+		free(li_a[i].acc);
+		memset(&li_a[i], 0, sizeof(li_a[i]));
+	}
+	pthread_mutex_unlock(&li_lock);
+}
+
+static void li_report(void)
+{
+	FILE *f = fopen("/tmp/q1lockin.txt", "w");
+	if (!f)
+		return;
+	fprintf(f, "samples %llu over %.1f s at %.2f Hz\n", (unsigned long long)li_n, (li_last - li_t0) * 1e-9, li_hz);
+	enum { TOP = 40 };
+	struct
+	{
+		double score, mean, amp, ph, sd;
+		int a;
+		uint64_t k;
+	} top[TOP];
+	memset(top, 0, sizeof(top));
+	for (int a = 0; a < LI_ALLOCS; a++) {
+		if (!li_a[a].acc)
+			continue;
+		for (uint64_t k = 0; k < li_a[a].nf; k++) {
+			double *x = li_a[a].acc + 4 * k, n = (double)li_n;
+			double mean = x[0] / n, var = x[3] / n - mean * mean;
+			double s = 2 * x[1] / n, c = 2 * x[2] / n, amp = sqrt(s * s + c * c);
+			if (!(var > 1e-14) || !(amp > 1e-6) || !isfinite(amp))
+				continue;
+			double score = amp / sqrt(2 * var); // 1 for a pure sine at the frequency
+			if (score <= top[TOP - 1].score)
+				continue;
+			int j = TOP - 1;
+			while (j > 0 && top[j - 1].score < score) {
+				top[j] = top[j - 1];
+				j--;
+			}
+			top[j].score = score;
+			top[j].mean = mean;
+			top[j].amp = amp;
+			top[j].ph = atan2(c, s);
+			top[j].sd = sqrt(var);
+			top[j].a = a;
+			top[j].k = k;
+		}
+	}
+	for (int j = 0; j < TOP && top[j].score > 0; j++)
+		fprintf(f, "score %.3f alloc %d size %llu type %u float %llu: mean %.6g amp %.6g sd %.6g phase %.1f\n", top[j].score,
+		        top[j].a, (unsigned long long)li_a[top[j].a].size, li_a[top[j].a].type, (unsigned long long)top[j].k,
+		        top[j].mean, top[j].amp, top[j].sd, top[j].ph * 57.29578);
+	fclose(f);
+}
+
+static void li_tick(struct device *d)
+{
+	uint64_t t = now_ns();
+	pthread_mutex_lock(&li_lock);
+	if (t - li_chk > 300000000ull) {
+		li_chk = t;
+		if (access("/tmp/q1-maplist", F_OK) == 0) {
+			unlink("/tmp/q1-maplist");
+			FILE *f = fopen("/tmp/q1maps.txt", "w");
+			for (int i = 0; f && i < LI_ALLOCS; i++)
+				if (li_a[i].ptr)
+					fprintf(f, "alloc %d size %llu mapped %llu type %u flags %x\n", i, (unsigned long long)li_a[i].size,
+					        (unsigned long long)li_a[i].mapsize, li_a[i].type,
+					        li_a[i].type < d->memprops.memoryTypeCount ? d->memprops.memoryTypes[li_a[i].type].propertyFlags
+					                                                  : 0);
+			if (f)
+				fclose(f);
+		}
+		FILE *f = fopen("/tmp/q1-lockin", "r");
+		double hz = 0;
+		unsigned long long mx = 0;
+		bool on = f && fscanf(f, "%lf %llu", &hz, &mx) == 2;
+		if (f)
+			fclose(f);
+		if (on && !li_on) {
+			li_on = true;
+			li_hz = hz;
+			li_max = mx;
+			li_n = 0;
+			li_t0 = t;
+			for (int i = 0; i < LI_ALLOCS; i++) {
+				free(li_a[i].acc);
+				li_a[i].acc = NULL;
+				li_a[i].nf = 0;
+				if (li_a[i].ptr && li_a[i].mapsize >= 64 && li_a[i].mapsize <= li_max) {
+					li_a[i].nf = li_a[i].mapsize / 4;
+					li_a[i].acc = calloc(4 * li_a[i].nf, sizeof(double));
+					if (!li_a[i].acc)
+						li_a[i].nf = 0;
+				}
+			}
+		} else if (!on && li_on) {
+			li_on = false;
+			li_report();
+			for (int i = 0; i < LI_ALLOCS; i++) {
+				free(li_a[i].acc);
+				li_a[i].acc = NULL;
+				li_a[i].nf = 0;
+			}
+		}
+	}
+	if (li_on && t - li_last > 4000000ull) {
+		li_last = t;
+		double w = 2 * M_PI * li_hz * (double)t * 1e-9, sn = sin(w), cs = cos(w);
+		li_n++;
+		for (int a = 0; a < LI_ALLOCS; a++) {
+			if (!li_a[a].acc || !li_a[a].ptr)
+				continue;
+			const float *p = (const float *)li_a[a].ptr;
+			double *x = li_a[a].acc;
+			for (uint64_t k = 0; k < li_a[a].nf; k++, x += 4) {
+				double v = p[k];
+				if (!isfinite(v))
+					v = 0;
+				x[0] += v;
+				x[1] += v * sn;
+				x[2] += v * cs;
+				x[3] += v * v;
+			}
+		}
+	}
+	pthread_mutex_unlock(&li_lock);
+}
