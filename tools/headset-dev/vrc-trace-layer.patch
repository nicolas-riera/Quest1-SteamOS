+// TEMP trace: /tmp/q1-trace: descriptor writes and binds to /tmp/q1trace.txt
+static FILE *tr_f;
+static uint64_t tr_chk;
+static pthread_mutex_t tr_lock = PTHREAD_MUTEX_INITIALIZER;
+static FILE *tr_get(void)
+{
+	uint64_t t = now_ns();
+	if (t - tr_chk > 300000000ull) {
+		tr_chk = t;
+		bool on = access("/tmp/q1-trace", F_OK) == 0;
+		if (on && !tr_f) {
+			char fn[128];
+			snprintf(fn, sizeof(fn), "/tmp/q1trace.%s.%d.txt", program_invocation_short_name, (int)getpid());
+			tr_f = fopen(fn, "w");
+		}
+		else if (!on && tr_f) {
+			fclose(tr_f);
+			tr_f = NULL;
+		}
+	}
+	return tr_f;
+}
