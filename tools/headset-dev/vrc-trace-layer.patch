+			fprintf(f, " %u", dyn[i]);
+		fputc(10, f);
+	}
+	pthread_mutex_unlock(&tr_lock);
+	((PFN_vkCmdBindDescriptorSets)device_of(cb)->gdpa(device_of(cb)->handle, "vkCmdBindDescriptorSets"))(cb, bp, layout, first, n,
