+
+// TEMP horizon probe: /tmp/q1-hzlog -> /tmp/q1hz.txt, per submit: time, buffer, pitch of the pose, the strongest
+// bright-over-dark edge row in two columns of each quarter of the atlas (its four views)
+#include <linux/dma-buf.h>
+#include <sys/ioctl.h>
+uint8_t *q1hz_map[32];
+int q1hz_fd[32];
+unsigned q1hz_stride, q1hz_w, q1hz_h;
+static void q1hz_probe(uint64_t now, int32_t index, const void *eye_l)
+{
+	static uint64_t chk;
+	static FILE *f;
+	if (now - chk > 300000000ull) {
+		chk = now;
+		bool on = access("/tmp/q1-hzlog", F_OK) == 0;
+		if (on && !f)
+			f = fopen("/tmp/q1hz.txt", "w");
+		else if (!on && f) {
+			fclose(f);
+			f = NULL;
+		}
+	}
+	if (!f || index < 0 || index >= 32 || !q1hz_map[index] || !q1hz_stride)
+		return;
+	const uint8_t *m = q1hz_map[index];
+	struct dma_buf_sync sy = {DMA_BUF_SYNC_START | DMA_BUF_SYNC_READ};
+	ioctl(q1hz_fd[index], DMA_BUF_IOCTL_SYNC, &sy);
+	float mt[12];
+	memcpy(mt, (const char *)eye_l + 16, sizeof(mt));
+	fprintf(f, "%llu buf %d pitch %.4f rows", (unsigned long long)now, index, asinf(-mt[6]) * 57.29578f);
+	unsigned w = q1hz_w, h = q1hz_h, st = q1hz_stride;
+	for (unsigned q = 0; q < 8; q++) {
+		unsigned x0 = q & 1 ? w * 3 / 4 : w / 4, r0 = (q / 2) * (h / 4), r1 = r0 + h / 4;
+		int best = -1, bg = 0;
+		for (unsigned r = r0 + 2; r + 2 < r1; r++) {
+			int g = (int)m[(size_t)(r - 2) * st + x0] - (int)m[(size_t)(r + 2) * st + x0];
+			if (g > bg) {
+				bg = g;
+				best = (int)r;
+			}
+		}
+		fprintf(f, " %d:%d", best, bg);
+	}
+	fputs("\n", f);
+	fflush(f);
+	sy.flags = DMA_BUF_SYNC_END | DMA_BUF_SYNC_READ;
+	ioctl(q1hz_fd[index], DMA_BUF_IOCTL_SYNC, &sy);
+}
