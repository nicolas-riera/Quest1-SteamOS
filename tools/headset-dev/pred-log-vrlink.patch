+// test only: /tmp/q1-shimreplay: the head recorded in /tmp/q1hd/headrec.txt ("t qx qy qz qw wx wy wz"), from its start
+// when the flag appears, looped, replaces the head's orientation and rate given to the PC
+#define RP_MAX 40000
+static int64_t rp_t[RP_MAX];
+static double rp_q[RP_MAX][4], rp_w[RP_MAX][3];
+static int rp_n = -1;
+static int64_t rp_t0;
+static bool replay_head(int64_t now, struct q1_hmd_pose *p)
+{
+	static uint64_t chk;
+	static bool on;
+	if ((uint64_t)now - chk > 300000000ull) {
+		chk = now;
+		bool want = access("/tmp/q1-shimreplay", F_OK) == 0;
+		if (want && !on)
+			rp_t0 = now;
+		on = want;
+	}
+	if (!on)
+		return false;
+	if (rp_n < 0) {
+		rp_n = 0;
+		FILE *f = fopen("/tmp/q1hd/headrec.txt", "r");
+		long long t;
+		double q[4], w[3];
+		while (f && rp_n < RP_MAX && fscanf(f, "%lld %lf %lf %lf %lf %lf %lf %lf", &t, &q[0], &q[1], &q[2], &q[3], &w[0], &w[1], &w[2]) == 8) {
+			rp_t[rp_n] = t;
+			rp_q[rp_n][0] = q[3], rp_q[rp_n][1] = q[0], rp_q[rp_n][2] = q[1], rp_q[rp_n][3] = q[2];
+			memcpy(rp_w[rp_n], w, sizeof(w));
+			rp_n++;
+		}
+		if (f)
+			fclose(f);
+		fprintf(stderr, "quest1_v4l2: vrlink: replay: %d head poses\n", rp_n);
+	}
+	if (rp_n < 2)
+		return false;
+	int64_t span = rp_t[rp_n - 1] - rp_t[0], at = rp_t[0] + (now - rp_t0) % span;
+	int lo = 0, hi = rp_n - 1;
+	while (hi - lo > 1) {
+		int mid = (lo + hi) / 2;
+		if (rp_t[mid] <= at)
+			lo = mid;
+		else
+			hi = mid;
+	}
+	memcpy(p->q, rp_q[lo], sizeof(p->q));
+	memcpy(p->ang, rp_w[lo], sizeof(p->ang));
+	return true;
+}
