+// TEMP: /tmp/q1-fake-yaw "<deg> <hz> [<m>]": a yaw sine (and a sideways x sine) added to every head pose (motion test
+// on a still headset)
+static double q1_fake_yaw(XrSpaceLocation &loc, int64_t monoNs, double *xvel = nullptr)
+{
+	static int64_t chk;
+	static double amp, hz, pos;
+	if (monoNs - chk > 300000000ll || monoNs < chk) {
+		chk = monoNs;
+		FILE *f = fopen("/tmp/q1-fake-yaw", "r");
+		int n = f ? fscanf(f, "%lf %lf %lf", &amp, &hz, &pos) : 0;
+		if (n < 2)
+			amp = hz = 0;
+		if (n < 3)
+			pos = 0;
+		if (f)
+			fclose(f);
+	}
+	if (hz == 0)
+		return 0;
+	double ph = 2 * M_PI * hz * (double)(monoNs % 1000000000000ll) * 1e-9;
+	loc.pose.position.x += (float)(pos * sin(ph));
+	if (xvel)
+		*xvel = pos * 2 * M_PI * hz * cos(ph);
+	double th = amp * M_PI / 180 * sin(ph), c = cos(th / 2), s = sin(th / 2);
+	XrQuaternionf q = loc.pose.orientation;
+	loc.pose.orientation = {(float)(c * q.x + s * q.z), (float)(c * q.y + s * q.w), (float)(c * q.z - s * q.x),
+	                        (float)(c * q.w - s * q.y)};
+	return amp * M_PI / 180 * 2 * M_PI * hz * cos(ph); // yaw rate, rad/s
+}
